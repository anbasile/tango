{
    "steps": {
        "train_data": {
            "type": "datasets::load",
            "path": "json",
            "data_files": {
                "train": "test_fixtures/integrations/datasets/train.jsonl",
                "validation": "test_fixtures/integrations/datasets/validation.jsonl"
            },
            "split": "train"
        },
        "dev_data": {
            "type": "datasets::load",
            "path": "json",
            "data_files": {
                "train": "test_fixtures/integrations/datasets/train.jsonl",
                "validation": "test_fixtures/integrations/datasets/validation.jsonl"
            },
            "split": "validation"
        },
        "all_data": {
            "type": "datasets::concatenate",
            "datasets": [
                {
                    "type": "ref",
                    "ref": "train_data"
                },
                {
                    "type": "ref",
                    "ref": "dev_data"
                }
            ]
        },
        "mixed_data": {
            "type": "datasets::interleave",
            "datasets": [
                {
                    "type": "ref",
                    "ref": "train_data"
                },
                {
                    "type": "ref",
                    "ref": "dev_data"
                }
            ],
            "probabilities": [0.9, 0.1]
        }
    }
}
